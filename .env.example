# Copy this file to .env and fill it in. .env is git-ignored: never commit it.
# ./dev.sh loads it before starting the app.

# Google OAuth client for Gmail. See docs/setup/gmail.md.
SILENTDESK_GOOGLE_CLIENT_ID=
SILENTDESK_GOOGLE_CLIENT_SECRET=

# Slack app client ID (PKCE, no secret). See docs/setup/slack.md.
SILENTDESK_SLACK_CLIENT_ID=
# Optional: only if port 47615 is taken. Must match the Slack app's redirect URL.
# SILENTDESK_SLACK_REDIRECT_PORT=47615

# Jira needs nothing here: connect in the app with your own API token
# (see docs/setup/jira.md). Tokens are kept in the system keychain, never in .env.

# Linux only: uncomment if the window is blank or crashes (some NVIDIA / Wayland setups).
# WEBKIT_DISABLE_DMABUF_RENDERER=1
