# Copy this file to .env and fill it in. .env is git-ignored: never commit it.
# ./dev.sh loads it before starting the app.

# Google OAuth client for Gmail. See docs/setup/gmail.md.
SILENTDESK_GOOGLE_CLIENT_ID=
SILENTDESK_GOOGLE_CLIENT_SECRET=

# Linux only: uncomment if the window is blank or crashes (some NVIDIA / Wayland setups).
# WEBKIT_DISABLE_DMABUF_RENDERER=1
