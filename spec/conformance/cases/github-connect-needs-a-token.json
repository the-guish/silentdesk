{
  "description": "connecting GitHub needs a token, and sends nothing without one",
  "env": {
    "SILENTDESK_TEST_KEYRING": "{home}/keyring.json",
    "SILENTDESK_TEST_BASE_URL": "{server}",
    "SILENTDESK_TEST_NOW": "2026-10-24T12:00:00Z"
  },
  "args": [
    "connect",
    "github"
  ],
  "stdin": {
    "server": "github.acme.com"
  },
  "exit": 1,
  "schema": "error.json",
  "stdout": {
    "error": {
      "kind": "auth",
      "message": {
        "$any": "string"
      }
    }
  },
  "requests": []
}
