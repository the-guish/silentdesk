{
  "description": "a reply goes to the thread's newest message, and deleting a topic trashes its thread",
  "env": {
    "SILENTDESK_TEST_KEYRING": "{home}/keyring.json",
    "SILENTDESK_TEST_BASE_URL": "{server}",
    "SILENTDESK_TEST_BROWSER": "follow",
    "SILENTDESK_TEST_NOW": "2026-10-24T12:00:00Z",
    "SILENTDESK_GOOGLE_CLIENT_ID": "test-client.apps.googleusercontent.com"
  },
  "http": [
    {
      "path": "/google-accounts/o/oauth2/v2/auth",
      "redirect": "{query.redirect_uri}?code=auth-code&state={query.state}"
    },
    {
      "method": "POST",
      "path": "/google-oauth/token",
      "body": {
        "access_token": "access-1",
        "refresh_token": "refresh-1",
        "scope": "https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/gmail.send"
      }
    },
    {
      "path": "/gmail/gmail/v1/users/me/profile",
      "body": {
        "emailAddress": "ana@example.com",
        "historyId": "500"
      }
    },
    {
      "path": "/gmail/gmail/v1/users/me/messages",
      "query": {
        "labelIds": "INBOX"
      },
      "body": {
        "messages": [
          {
            "id": "m3"
          },
          {
            "id": "m2"
          },
          {
            "id": "m1"
          }
        ]
      }
    },
    {
      "path": "/gmail/gmail/v1/users/me/messages/m1",
      "body": {
        "id": "m1",
        "threadId": "t1",
        "labelIds": [
          "INBOX"
        ],
        "internalDate": "1761300000000",
        "payload": {
          "headers": [
            {
              "name": "Subject",
              "value": "Invoice for October"
            },
            {
              "name": "From",
              "value": "Bo Lind <bo@acme.com>"
            },
            {
              "name": "To",
              "value": "ana@example.com"
            },
            {
              "name": "Message-ID",
              "value": "<m1@mail.example>"
            }
          ]
        }
      }
    },
    {
      "path": "/gmail/gmail/v1/users/me/messages/m2",
      "body": {
        "id": "m2",
        "threadId": "t1",
        "labelIds": [
          "INBOX"
        ],
        "internalDate": "1761303600000",
        "payload": {
          "headers": [
            {
              "name": "Subject",
              "value": "Re: Invoice for October"
            },
            {
              "name": "From",
              "value": "Bo Lind <bo@acme.com>"
            },
            {
              "name": "To",
              "value": "ana@example.com"
            },
            {
              "name": "Message-ID",
              "value": "<m2@mail.example>"
            }
          ]
        }
      }
    },
    {
      "path": "/gmail/gmail/v1/users/me/messages/m3",
      "body": {
        "id": "m3",
        "threadId": "t2",
        "labelIds": [
          "INBOX",
          "SENT"
        ],
        "internalDate": "1761310800000",
        "payload": {
          "headers": [
            {
              "name": "Subject",
              "value": "Lunch?"
            },
            {
              "name": "From",
              "value": "cy@example.com"
            },
            {
              "name": "To",
              "value": "ana@example.com"
            },
            {
              "name": "Message-ID",
              "value": "<m3@mail.example>"
            }
          ]
        }
      }
    },
    {
      "method": "POST",
      "path": "/gmail/gmail/v1/users/me/messages/send",
      "body": {
        "id": "sent-1",
        "threadId": "t1"
      }
    },
    {
      "method": "POST",
      "path": "/gmail/gmail/v1/users/me/threads/t1/trash",
      "body": {
        "id": "t1"
      }
    }
  ],
  "steps": [
    {
      "args": [
        "connect",
        "gmail"
      ],
      "exit": 0,
      "schema": "status.json",
      "stdout": {
        "service": "gmail",
        "configured": true,
        "connected": true,
        "account": "ana@example.com"
      }
    },
    {
      "args": [
        "sync",
        "gmail"
      ],
      "exit": 0,
      "schema": "sync.json",
      "stdout": {
        "lastSynced": "2026-10-24T12:00:00Z"
      }
    },
    {
      "args": [
        "topics"
      ],
      "exit": 0,
      "schema": "topics.json",
      "stdout": [
        {
          "id": {
            "$any": "string"
          },
          "service": "gmail",
          "title": "Lunch?",
          "items": [
            {
              "key": "m3",
              "direction": "outbound",
              "author": "cy@example.com",
              "url": "https://mail.google.com/mail/#all/t2",
              "date": "2025-10-24T13:00:00Z"
            }
          ],
          "updatedAt": "2025-10-24T13:00:00Z"
        },
        {
          "id": {
            "$any": "string"
          },
          "service": "gmail",
          "title": "Invoice for October",
          "items": [
            {
              "key": "m1",
              "direction": "inbound",
              "author": "Bo Lind",
              "url": "https://mail.google.com/mail/#all/t1",
              "date": "2025-10-24T10:00:00Z"
            },
            {
              "key": "m2",
              "direction": "inbound",
              "author": "Bo Lind",
              "url": "https://mail.google.com/mail/#all/t1",
              "date": "2025-10-24T11:00:00Z"
            }
          ],
          "updatedAt": "2025-10-24T11:00:00Z"
        }
      ],
      "capture": {
        "invoice": [
          1,
          "id"
        ]
      }
    },
    {
      "args": [
        "reply",
        "{capture.invoice}"
      ],
      "stdin": "Thanks, it's paid.",
      "exit": 0,
      "schema": "empty.json",
      "stdout": {}
    },
    {
      "args": [
        "delete",
        "{capture.invoice}"
      ],
      "exit": 0,
      "schema": "empty.json",
      "stdout": {}
    },
    {
      "args": [
        "topics"
      ],
      "exit": 0,
      "schema": "topics.json",
      "stdout": [
        {
          "id": {
            "$any": "string"
          },
          "service": "gmail",
          "title": "Lunch?",
          "items": [
            {
              "key": "m3",
              "direction": "outbound",
              "author": "cy@example.com",
              "url": "https://mail.google.com/mail/#all/t2",
              "date": "2025-10-24T13:00:00Z"
            }
          ],
          "updatedAt": "2025-10-24T13:00:00Z"
        }
      ]
    }
  ],
  "requests": [
    {
      "path": "/google-accounts/o/oauth2/v2/auth"
    },
    {
      "method": "POST",
      "path": "/google-oauth/token"
    },
    {
      "path": "/gmail/gmail/v1/users/me/profile"
    },
    {
      "method": "POST",
      "path": "/google-oauth/token"
    },
    {
      "path": "/gmail/gmail/v1/users/me/profile"
    },
    {
      "path": "/gmail/gmail/v1/users/me/messages"
    },
    {
      "path": "/gmail/gmail/v1/users/me/messages/m3"
    },
    {
      "path": "/gmail/gmail/v1/users/me/messages/m2"
    },
    {
      "path": "/gmail/gmail/v1/users/me/messages/m1"
    },
    {
      "method": "POST",
      "path": "/google-oauth/token"
    },
    {
      "path": "/gmail/gmail/v1/users/me/messages/m2",
      "query": {
        "format": "metadata"
      }
    },
    {
      "method": "POST",
      "path": "/gmail/gmail/v1/users/me/messages/send",
      "headers": {
        "Authorization": "Bearer access-1"
      },
      "body": {
        "threadId": "t1",
        "raw": {
          "$any": "string"
        }
      }
    },
    {
      "method": "POST",
      "path": "/google-oauth/token"
    },
    {
      "method": "POST",
      "path": "/gmail/gmail/v1/users/me/threads/t1/trash"
    }
  ]
}
