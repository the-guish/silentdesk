{
  "description": "disconnecting GitHub forgets its token and drops its topics",
  "env": {
    "SILENTDESK_TEST_KEYRING": "{home}/keyring.json",
    "SILENTDESK_TEST_BASE_URL": "{server}",
    "SILENTDESK_TEST_NOW": "2026-10-24T12:00:00Z"
  },
  "http": [
    {
      "path": "/github/user",
      "body": {
        "login": "ana",
        "name": "Ana Ruiz"
      }
    },
    {
      "path": "/github/search/issues",
      "query": {
        "q": "is:pr is:open archived:false review-requested:@me"
      },
      "status": 200,
      "body": {
        "items": [
          {
            "id": 11,
            "number": 4,
            "title": "Add retries",
            "html_url": "https://github.com/acme/web/pull/4",
            "repository_url": "https://api.github.com/repos/acme/web",
            "user": {
              "login": "bo"
            },
            "draft": false,
            "updated_at": "2026-10-23T09:00:00Z"
          }
        ]
      }
    },
    {
      "path": "/github/search/issues",
      "query": {
        "q": "is:pr is:open archived:false assignee:@me"
      },
      "status": 200,
      "body": {
        "items": []
      }
    },
    {
      "path": "/github/search/issues",
      "query": {
        "q": "is:pr is:open archived:false author:@me"
      },
      "status": 200,
      "body": {
        "items": []
      }
    }
  ],
  "steps": [
    {
      "args": [
        "connect",
        "github"
      ],
      "stdin": {
        "token": "ghp_test"
      },
      "exit": 0,
      "schema": "status.json",
      "stdout": {
        "service": "github",
        "configured": true,
        "connected": true,
        "account": "ana · github.com"
      }
    },
    {
      "args": [
        "sync",
        "github"
      ],
      "exit": 0,
      "schema": "sync.json",
      "stdout": {
        "lastSynced": "2026-10-24T12:00:00Z"
      }
    },
    {
      "args": [
        "disconnect",
        "github"
      ],
      "exit": 0,
      "schema": "status.json",
      "stdout": {
        "service": "github",
        "configured": true,
        "connected": false,
        "account": null
      }
    },
    {
      "args": [
        "topics"
      ],
      "exit": 0,
      "schema": "topics.json",
      "stdout": []
    }
  ]
}
