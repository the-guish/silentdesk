{
  "description": "a GitHub Enterprise Server host names the account; plain http is refused",
  "env": {
    "SILENTDESK_TEST_KEYRING": "{home}/keyring.json",
    "SILENTDESK_TEST_BASE_URL": "{server}",
    "SILENTDESK_TEST_NOW": "2026-10-24T12:00:00Z"
  },
  "http": [
    {
      "path": "/github/user",
      "body": {
        "login": "ana",
        "name": "Ana Ruiz"
      }
    }
  ],
  "steps": [
    {
      "args": [
        "connect",
        "github"
      ],
      "stdin": {
        "token": "ghp_test",
        "server": "http://github.acme.com"
      },
      "exit": 1,
      "schema": "error.json",
      "stdout": {
        "error": {
          "kind": "auth",
          "message": {
            "$any": "string"
          }
        }
      }
    },
    {
      "args": [
        "connect",
        "github"
      ],
      "stdin": {
        "token": "ghp_test",
        "server": "github.acme.com"
      },
      "exit": 0,
      "schema": "status.json",
      "stdout": {
        "service": "github",
        "configured": true,
        "connected": true,
        "account": "ana · github.acme.com"
      }
    }
  ]
}
