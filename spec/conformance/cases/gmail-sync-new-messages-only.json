      "path": "/google-accounts/o/oauth2/v2/auth",
      "redirect": "{query.redirect_uri}?code=auth-code&state={query.state}"
    },
    {
      "method": "POST",
      "path": "/google-oauth/token",
      "body": {
        "access_token": "access-1",
        "refresh_token": "refresh-1",
        "scope": "https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/gmail.send"
      }
    },
    {
      "path": "/gmail/gmail/v1/users/me/profile",
      "body": {
        "emailAddress": "ana@example.com",
        "historyId": "500"
      }
    },
    {
      "path": "/gmail/gmail/v1/users/me/messages",
      "query": {
        "labelIds": "INBOX"
      },
      "body": {
        "messages": [
          {
            "id": "m3"
          },
          {
            "id": "m2"
          },
          {
            "id": "m1"
          }
        ]
      }
    },
    {
      "path": "/gmail/gmail/v1/users/me/messages/m1",
