{
  "description": "Google Tasks cannot sign in without a Google client ID, and opens no page",
  "env": {
    "SILENTDESK_TEST_KEYRING": "{home}/keyring.json",
    "SILENTDESK_TEST_BASE_URL": "{server}",
    "SILENTDESK_TEST_BROWSER": "follow",
    "SILENTDESK_TEST_NOW": "2026-10-24T12:00:00Z"
  },
  "args": [
    "connect",
    "tasks"
  ],
  "exit": 1,
  "schema": "error.json",
  "stdout": {
    "error": {
      "kind": "auth",
      "message": {
        "$any": "string"
      }
    }
  },
  "requests": []
}
