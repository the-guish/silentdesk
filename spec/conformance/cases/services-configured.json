{
  "description": "a Google client ID configures Gmail and Google Tasks",
  "args": [
    "services"
  ],
  "env": {
    "SILENTDESK_TEST_KEYRING": "{home}/keyring.json",
    "SILENTDESK_GOOGLE_CLIENT_ID": "test-client.apps.googleusercontent.com"
  },
  "exit": 0,
  "schema": "services.json",
  "stdout": [
    {
      "service": "github",
      "configured": true,
      "connected": false,
      "account": null
    },
    {
      "service": "gmail",
      "configured": true,
      "connected": false,
      "account": null
    },
    {
      "service": "tasks",
      "configured": true,
      "connected": false,
      "account": null
    }
  ]
}
