        "ok": true,
        "messages": {
          "matches": [
            {
              "type": "im",
              "channel": {
                "id": "D1",
                "name": "U2",
                "is_im": true,
                "is_mpim": false
              },
              "user": "U0",
              "text": "On it, <@U2>",
