{
  "description": "a refresh token Google no longer accepts is forgotten on sync",
  "env": {
    "SILENTDESK_TEST_KEYRING": "{home}/keyring.json",
    "SILENTDESK_TEST_BASE_URL": "{server}",
    "SILENTDESK_TEST_BROWSER": "follow",
    "SILENTDESK_TEST_NOW": "2026-10-24T12:00:00Z",
    "SILENTDESK_GOOGLE_CLIENT_ID": "test-client.apps.googleusercontent.com"
  },
  "files": {
    "keyring.json": {
      "google-tasks-refresh-token": "dead-token"
    }
  },
  "http": [
    {
      "method": "POST",
      "path": "/google-oauth/token",
      "status": 400,
      "body": {
        "error": "invalid_grant"
      }
    }
  ],
  "steps": [
    {
      "args": [
        "sync",
        "tasks"
      ],
      "exit": 1,
      "schema": "error.json",
      "stdout": {
        "error": {
          "kind": "auth",
          "message": {
            "$any": "string"
          }
        }
      }
    },
    {
      "args": [
        "services"
      ],
      "exit": 0,
      "schema": "services.json",
      "stdout": [
        {
          "service": "github",
          "configured": true,
          "connected": false,
          "account": null
        },
        {
          "service": "gmail",
          "configured": true,
          "connected": false,
          "account": null
        },
        {
          "service": "jira",
          "configured": true,
          "connected": false,
          "account": null
        },
        {
          "service": "tasks",
          "configured": true,
          "connected": false,
          "account": null
        }
      ]
    }
  ]
}
