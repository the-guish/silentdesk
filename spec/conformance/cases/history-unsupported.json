{
  "description": "a service that keeps no conversation has no history to show",
  "env": {
    "SILENTDESK_TEST_KEYRING": "{home}/keyring.json",
    "SILENTDESK_TEST_BASE_URL": "{server}",
    "SILENTDESK_TEST_NOW": "2026-10-24T12:00:00Z"
  },
  "http": [
    {
      "path": "/github/user",
      "body": {
        "login": "ana",
        "name": "Ana Ruiz"
      }
    },
    {
      "method": "POST",
      "path": "/github/graphql",
      "body": {
        "data": {
          "reviewRequested": {
            "nodes": [
              {
                "databaseId": 11,
                "number": 4,
                "title": "Add retries",
                "url": "https://github.com/acme/web/pull/4",
                "updatedAt": "2026-10-23T09:00:00Z",
                "isDraft": false,
                "state": "OPEN",
                "merged": false,
                "reviewDecision": null,
                "author": {
                  "login": "bo"
                },
                "repository": {
                  "nameWithOwner": "acme/web"
                },
                "commits": {
                  "nodes": [
                    {
                      "commit": {
                        "statusCheckRollup": null
                      }
                    }
                  ]
                }
              }
            ]
          },
          "assigned": {
            "nodes": []
          },
          "authored": {
            "nodes": []
          }
        }
      }
    }
  ],
  "steps": [
    {
      "args": [
        "connect",
        "github"
      ],
      "stdin": {
        "token": "ghp_test"
      },
      "exit": 0,
      "schema": "status.json",
      "stdout": {
        "service": "github",
        "configured": true,
        "connected": true,
        "account": "ana · github.com"
      }
    },
    {
      "args": [
        "sync",
        "github"
      ],
      "exit": 0,
      "schema": "sync.json",
      "stdout": {
        "lastSynced": "2026-10-24T12:00:00Z"
      }
    },
    {
      "args": [
        "topics"
      ],
      "exit": 0,
      "schema": "topics.json",
      "stdout": [
        {
          "$any": "object"
        }
      ],
      "capture": {
        "topic": [
          0,
          "id"
        ]
      }
    },
    {
      "args": [
        "history",
        "{capture.topic}"
      ],
      "exit": 1,
      "schema": "error.json",
      "stdout": {
        "error": {
          "kind": "unsupported",
          "message": {
            "$any": "string"
          }
        }
      }
    }
  ]
}
